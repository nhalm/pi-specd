{
  "name": "@nhalm/pi-specd",
  "version": "0.0.1",
  "type": "module",
  "description": "Spec-driven development workflow for pi",
  "keywords": [
    "pi-package",
    "pi",
    "specd"
  ],
  "pi": {
    "extensions": [
      "./extensions/specd-loop"
    ]
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sync-version": "node scripts/sync-version.mjs",
    "prepublishOnly": "node scripts/sync-version.mjs"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mariozechner/pi-coding-agent": "^0.70.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "lefthook": "^1.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
