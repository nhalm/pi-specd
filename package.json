{
  "name": "@nhalm/pi-specd",
  "version": "1.1.1",
  "type": "module",
  "description": "Spec-driven development workflow for pi",
  "keywords": [
    "pi-package",
    "pi",
    "specd"
  ],
  "pi": {
    "extensions": [
      "./extensions/specd-loop"
    ]
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-version": "node scripts/sync-version.mjs",
    "prepublishOnly": "node scripts/sync-version.mjs"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
